# PRIVATE: never commit (git-ignored). Local values for npm run dev / preview / build.

# The enquiry form posts to the site's own relay, which adds the secret key.
PUBLIC_CRM_LEAD_URL=/api/lead.php

# Leadrat Website integration. Server-side only (dev/preview relay); never PUBLIC_.
# On Hostinger the key lives in leadrat-config.php above public_html instead.
LEADRAT_API_KEY=NDZkNjJkNzUtODY3MS00NjZkLThlNzEtNjc3ZmZjZTRjMzRm
LEADRAT_API_URL=https://connect.leadrat.com/api/v1/integration/Website

# Leadrat user (full name) every website lead is assigned to, so it shows in
# All / My Leads. Change to any team member's name.
LEADRAT_PRIMARY_USER=Gaurav Sharma
