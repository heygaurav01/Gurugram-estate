# Public build-time values. These ship to the browser, so only PUBLIC values go here.
# Copy to .env (local) or set in Cloudflare Pages > Settings > Environment variables.

# CRM lead-capture endpoint the enquiry form posts to (src/scripts/api.ts).
# Must be a PUBLIC web-form/lead-capture URL with CORS allowed for the site domain.
# Never a private API key. Empty in dev = submissions are simulated.
PUBLIC_CRM_LEAD_URL=

# Analytics (Phase 5)
PUBLIC_GA4_ID=
PUBLIC_GADS_ID=
PUBLIC_GADS_LEAD_LABEL=
PUBLIC_META_PIXEL_ID=
