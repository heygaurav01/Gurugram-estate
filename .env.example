# Copy to .env for local work. .env is git-ignored; never commit real values.

# Where the enquiry form posts. The site's own relay (public/api/lead.php on
# Hostinger, the dev relay in astro.config.mjs locally) adds the secret CRM key.
# Empty = submissions are simulated (dev and preview only).
PUBLIC_CRM_LEAD_URL=/api/lead.php

# Leadrat Website integration. SECRET, server-side only, never a PUBLIC_ variable.
# Used by the local relay. On Hostinger put it in leadrat-config.php above
# public_html (template: public/api/leadrat-config.example.php).
LEADRAT_API_KEY=
LEADRAT_API_URL=https://connect.leadrat.com/api/v1/integration/Website

# Analytics (Phase 5)
PUBLIC_GA4_ID=
PUBLIC_GADS_ID=
PUBLIC_GADS_LEAD_LABEL=
PUBLIC_META_PIXEL_ID=
