---
/**
 * About the company (brand_name) (#contact). Also the no-JS target of every enquiry CTA,
 * so it always offers a way to get in touch. TBD values are hidden.
 */
import type { Project, SiteSettings } from "~/lib/schemas";
import { ON_REQUEST } from "~/lib/compliance";
import { contactView } from "~/lib/view";
import Disclosure from "./Disclosure.astro";

type Props = { settings: SiteSettings; project?: Project | undefined };
const { settings, project } = Astro.props;
const c = contactView(settings, project);
---

<section class="section about" id="contact" aria-labelledby="about-title">
  <div class="container grid split-7-5">
    <div class="stack" data-reveal>
      <p class="eyebrow">About us</p>
      <h2 id="about-title">About {c.brand}</h2>
      <p class="about__lead">
        A Gurugram real estate company since 2019, led by director Ashish Gutt and his 15 years in
        Gurgaon real estate. We help buyers find and compare the right new home, visit the sites
        with them and see every step of the paperwork through.
      </p>
      <p class="about__more">
        We advise across Golf Course Road, Golf Course Extension Road, Dwarka Expressway and New
        Gurugram. Every fact we share comes with its source, and one advisor stays with you from the
        first call to the keys.
      </p>
      <Disclosure settings={settings} developer={project?.developer} />
    </div>
    <div data-reveal>
      <dl class="about__facts">
        <div>
          <dt>HARERA agent registration</dt>
          <dd>{c.reraNo ?? ON_REQUEST}</dd>
        </div>
        {c.phone && (
          <div>
            <dt>Phone</dt>
            <dd>
              <a href={c.phone.href} data-track="call_click">
                {c.phone.display}
              </a>
            </dd>
          </div>
        )}
        {c.email && (
          <div>
            <dt>Email</dt>
            <dd>
              <a href={`mailto:${c.email}`}>{c.email}</a>
            </dd>
          </div>
        )}
        {c.address && (
          <div>
            <dt>Office</dt>
            <dd>{c.address}</dd>
          </div>
        )}
      </dl>
      <div class="about__actions">
        {c.phone && (
          <a class="btn" href={c.phone.href} data-track="call_click">
            Call us
          </a>
        )}
        {c.whatsapp && (
          <a
            class="btn btn--ghost"
            href={c.whatsapp.href}
            rel="noopener"
            target="_blank"
            data-track="whatsapp_click"
          >
            WhatsApp<span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .about__lead {
    font-size: var(--step-1);
    line-height: 1.5;
  }
  .about__more {
    max-width: 56ch;
    color: var(--ink-2);
  }
  .about__facts {
    display: grid;
    border-top: 1px solid var(--hairline);
  }
  .about__facts > div {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--hairline);
  }
  .about__facts dt {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--stone);
  }
  .about__facts dd {
    font-size: var(--step-1);
    overflow-wrap: anywhere;
  }
  .about__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
</style>
