---
/**
 * Inline enquiry form (hub About section). Same rules, consent notice and CRM
 * connector as the project modal; logic in scripts/contact-form.ts.
 * Success redirects to /thank-you/ only after the CRM confirms.
 */
import type { SiteSettings } from "~/lib/schemas";
import { CONSENT_VERSION, consentText } from "~/lib/validation";
import { contactView } from "~/lib/view";
import { companyName } from "~/lib/compliance";

type Props = { settings: SiteSettings };
const { settings } = Astro.props;
const brand = companyName(settings);
const consent = consentText(brand);
const consentLead = consent.replace(/ the Privacy Policy\.$/, "");
const c = contactView(settings);
---

<form
  class="cf"
  novalidate
  data-contact-form
  data-consent-version={CONSENT_VERSION}
  data-consent-text={consent}
  aria-labelledby="cf-title"
>
  <p class="cf__eyebrow">Enquiry</p>
  <h3 id="cf-title" class="cf__title">
    Get notified at launch
  </h3>
  <p class="cf__intro">Tell us how to reach you. Free, with no obligation.</p>

  <div class="cf__field">
    <label for="cf-name">Name</label>
    <input
      id="cf-name"
      name="name"
      type="text"
      autocomplete="name"
      required
      maxlength="60"
      placeholder="Your full name"
      aria-describedby="cf-name-error"
    />
    <p id="cf-name-error" class="cf__error" data-error-for="name"></p>
  </div>
  <div class="cf__field">
    <label for="cf-phone">Mobile number</label>
    <div class="cf__phone">
      <span aria-hidden="true">+91</span>
      <input
        id="cf-phone"
        name="phone"
        type="tel"
        inputmode="numeric"
        autocomplete="tel-national"
        required
        maxlength="16"
        placeholder="10-digit mobile"
        aria-describedby="cf-phone-error"
      />
    </div>
    <p id="cf-phone-error" class="cf__error" data-error-for="phone"></p>
  </div>
  <div class="cf__field">
    <label for="cf-email">
      Email <span class="cf__optional">(optional)</span>
    </label>
    <input
      id="cf-email"
      name="email"
      type="email"
      autocomplete="email"
      maxlength="254"
      placeholder="you@example.com"
      aria-describedby="cf-email-error"
    />
    <p id="cf-email-error" class="cf__error" data-error-for="email"></p>
  </div>

  <div class="cf__hp" aria-hidden="true">
    <label for="cf-company">Company website</label>
    <input id="cf-company" name="company_website" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <p class="visually-hidden" aria-live="polite" data-cf-live></p>

  <p class="cf__consent" id="cf-consent-note">
    {consentLead} the{" "}
    <a href="/privacy-policy/" target="_blank" rel="noopener">
      Privacy Policy<span class="visually-hidden"> (opens in a new tab)</span>
    </a>
    .
  </p>
  <button type="submit" class="btn cf__submit" aria-describedby="cf-consent-note" data-cf-submit>
    <span class="cf__spinner" aria-hidden="true"></span>
    <span data-cf-label>Send</span>
  </button>

  <div class="cf__failure" role="alert" hidden data-cf-failure>
    <p>We could not send your details. Please try again, or call or WhatsApp us.</p>
    <div class="cf__actions">
      <button type="submit" class="btn">
        Try again
      </button>
      {c.phone && (
        <a class="btn btn--ghost" href={c.phone.href}>
          Call
        </a>
      )}
      {c.whatsapp && (
        <a class="btn btn--ghost" href={c.whatsapp.href} target="_blank" rel="noopener">
          WhatsApp<span class="visually-hidden"> (opens in a new tab)</span>
        </a>
      )}
    </div>
  </div>
</form>

<script>
  import { initContactForm } from "~/scripts/contact-form";
  import { captureAttribution } from "~/scripts/attribution";
  captureAttribution();
  initContactForm();
</script>

<style>
  .cf {
    display: grid;
    gap: var(--space-4);
    padding: clamp(var(--space-5), 4vw, var(--space-7));
    border: 1px solid var(--hairline);
    border-radius: 6px;
    background: var(--paper);
    box-shadow: 0 30px 60px -36px rgb(18 17 15 / 0.45);
  }
  .cf__eyebrow {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--stone);
  }
  .cf__title {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 1.5rem + 1.4vw, 2.6rem);
    font-weight: 500;
    line-height: 1;
  }
  .cf__intro {
    color: var(--ink-2);
  }
  .cf__field {
    display: grid;
    gap: var(--space-1);
  }
  .cf__field label {
    font-size: 0.82rem;
    font-weight: 600;
  }
  .cf__optional {
    font-weight: 400;
    color: var(--stone);
  }
  .cf__field input {
    width: 100%;
    min-height: 50px;
    padding: 0 var(--space-4);
    background: var(--bone);
    border: 1px solid var(--hairline);
    border-bottom-color: var(--stone);
    border-radius: var(--radius);
    font-size: 1rem;
  }
  .cf__field input::placeholder {
    color: #8f8a80;
  }
  .cf__field input:focus-visible {
    outline: none;
    border-color: var(--ink);
    box-shadow: 0 0 0 3px rgb(21 21 21 / 0.12);
  }
  .cf__field input[aria-invalid="true"] {
    border-color: var(--error);
  }
  .cf__phone {
    display: flex;
  }
  .cf__phone > span {
    display: grid;
    place-items: center;
    padding: 0 var(--space-4);
    background: var(--hairline);
    border: 1px solid var(--hairline);
    border-bottom-color: var(--stone);
    border-right: 0;
    border-radius: var(--radius) 0 0 var(--radius);
    font-weight: 600;
  }
  .cf__phone input {
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .cf__error {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--error);
  }
  .cf__error:empty {
    display: none;
  }
  .cf__hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .cf__consent {
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--stone);
  }
  .cf__submit {
    width: 100%;
    min-height: 54px;
  }
  .cf__spinner {
    display: none;
    width: 1rem;
    height: 1rem;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    animation: cf-spin 0.8s linear infinite;
  }
  .cf[aria-busy="true"] .cf__spinner {
    display: inline-block;
  }
  @keyframes cf-spin {
    to {
      transform: rotate(360deg);
    }
  }
  .cf__failure {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px solid var(--error);
    border-radius: var(--radius);
  }
  .cf__failure[hidden] {
    display: none;
  }
  .cf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .cf.is-failed .cf__submit {
    display: none;
  }
</style>
