---
/** Required agent disclosure. Text is generated by agentDisclosure() so it is identical everywhere. */
import type { Project, SiteSettings } from "~/lib/schemas";
import { agentDisclosure } from "~/lib/compliance";

type Props = {
  settings: SiteSettings;
  developer?: Project["developer"] | undefined;
  tone?: "light" | "dark";
};
const { settings, developer, tone = "light" } = Astro.props;
---

<p class:list={["disclosure", `disclosure--${tone}`]}>{agentDisclosure(settings, developer)}</p>

<style>
  .disclosure {
    font-size: var(--step--1);
    line-height: 1.5;
    max-width: 62ch;
  }
  .disclosure--light {
    color: var(--stone);
  }
  .disclosure--dark {
    color: rgb(244 241 234 / 0.82);
  }
</style>
