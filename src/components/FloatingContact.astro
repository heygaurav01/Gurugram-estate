---
/**
 * Floating Call and WhatsApp buttons, fixed bottom-right on every page.
 * Rendered only when the numbers are well-formed. On phones they sit above
 * the sticky Enquire bar.
 */
import type { Project, SiteSettings } from "~/lib/schemas";
import { contactView } from "~/lib/view";

type Props = { settings: SiteSettings; project?: Pick<Project, "name"> | undefined };
const { settings, project } = Astro.props;
const c = contactView(settings, project);
---

{(c.whatsapp || c.phone) && (
  <div class="fab" role="group" aria-label="Contact us">
    {c.whatsapp && (
      <a
        class="fab__btn fab__btn--wa"
        href={c.whatsapp.href}
        target="_blank"
        rel="noopener"
        data-track="whatsapp_click"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            class="fab__wa-bubble"
            d="M12 2.8a9.2 9.2 0 0 0-7.9 13.9L2.8 21.2l4.6-1.2A9.2 9.2 0 1 0 12 2.8z"
          ></path>
          <path
            class="fab__wa-phone"
            d="M9.1 7.6c.2-.4.4-.4.7-.4h.6c.2 0 .4.1.5.4l.8 1.9c.1.2 0 .5-.1.6l-.6.7c-.1.2-.2.4 0 .6.6 1.1 1.5 2 2.6 2.6.2.1.4.1.6-.1l.7-.8c.2-.2.4-.2.6-.1l1.9.9c.2.1.4.3.3.6l-.1.6c-.1.8-1 1.5-1.8 1.6-3.4.3-7.3-3.6-7-7 .1-.8.4-1.3.6-1.6z"
          ></path>
        </svg>
        <span class="fab__label">WhatsApp us</span>
        <span class="visually-hidden"> (opens in a new tab)</span>
      </a>
    )}
    {c.phone && (
      <a class="fab__btn fab__btn--call" href={c.phone.href} data-track="call_click">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6.6 3.5h3l1.6 4.2-2 1.3a11.5 11.5 0 0 0 5.8 5.8l1.3-2 4.2 1.6v3a2.1 2.1 0 0 1-2.2 2.1A17 17 0 0 1 4.5 5.7 2.1 2.1 0 0 1 6.6 3.5z"></path>
        </svg>
        <span class="fab__label">Call {c.phone.display}</span>
      </a>
    )}
  </div>
)}

<style>
  .fab {
    position: fixed;
    right: clamp(14px, 2vw, 28px);
    bottom: clamp(14px, 2vw, 28px);
    z-index: 45;
    display: grid;
    justify-items: end;
    gap: 12px;
  }
  .fab__btn {
    position: relative;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    text-decoration: none;
    box-shadow:
      0 10px 24px -8px rgb(0 0 0 / 0.45),
      0 2px 6px rgb(0 0 0 / 0.15);
    transition:
      transform 300ms var(--ease),
      box-shadow 300ms var(--ease);
  }
  .fab__btn:hover {
    transform: translateY(-2px) scale(1.05);
    box-shadow:
      0 16px 30px -10px rgb(0 0 0 / 0.5),
      0 2px 6px rgb(0 0 0 / 0.15);
  }
  .fab__btn:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }
  .fab__btn svg {
    width: 28px;
    height: 28px;
  }
  .fab__btn--wa {
    background: #25d366;
  }
  .fab__wa-bubble {
    fill: none;
    stroke: #fff;
    stroke-width: 1.7;
    stroke-linejoin: round;
  }
  .fab__wa-phone {
    fill: #fff;
  }
  .fab__btn--call {
    background: var(--ink);
  }
  .fab__btn--call svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: var(--bone);
    stroke-width: 1.7;
    stroke-linejoin: round;
  }
  /* Label slides out on hover/focus (pointer devices). */
  .fab__label {
    position: absolute;
    right: calc(100% + 10px);
    top: 50%;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--bone);
    font-size: 0.8rem;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    transform: translate(6px, -50%);
    pointer-events: none;
    transition:
      opacity 200ms var(--ease),
      transform 200ms var(--ease);
  }
  @media (hover: hover) {
    .fab__btn:hover .fab__label,
    .fab__btn:focus-visible .fab__label {
      opacity: 1;
      transform: translate(0, -50%);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .fab {
      animation: fab-in 600ms var(--ease) 600ms both;
    }
  }
  @keyframes fab-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
</style>
