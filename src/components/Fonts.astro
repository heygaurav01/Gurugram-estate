---
/**
 * Self-hosted Latin-only variable fonts.
 * Display: Cormorant Garamond (roman preloaded, italic on demand for accents).
 * Body: Manrope. Only the two above-the-fold files are preloaded.
 */
import displayUrl from "@fontsource-variable/cormorant-garamond/files/cormorant-garamond-latin-wght-normal.woff2?url";
import displayItalicUrl from "@fontsource-variable/cormorant-garamond/files/cormorant-garamond-latin-wght-italic.woff2?url";
import manropeUrl from "@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url";

const LATIN =
  "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+20B9,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD";

const css = `
@font-face{font-family:"Cormorant Garamond Variable";font-style:normal;font-display:swap;font-weight:300 700;src:url(${displayUrl}) format("woff2-variations");unicode-range:${LATIN}}
@font-face{font-family:"Cormorant Garamond Variable";font-style:italic;font-display:swap;font-weight:300 700;src:url(${displayItalicUrl}) format("woff2-variations");unicode-range:${LATIN}}
@font-face{font-family:"Manrope Variable";font-style:normal;font-display:swap;font-weight:200 800;src:url(${manropeUrl}) format("woff2-variations");unicode-range:${LATIN}}
`;
---

<link rel="preload" href={displayUrl} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={manropeUrl} as="font" type="font/woff2" crossorigin />
<style is:global set:html={css}></style>
