---
/**
 * Full-bleed hero in two zones:
 *  1. Headline block: eyebrow, H1 (project name with primary keyword), tagline, CTAs.
 *  2. Info strip along the bottom: RERA status, status line, agent disclosure.
 * The only gradient on the site is the legibility scrim.
 */
import type { Asset, Project, SiteSettings } from "~/lib/schemas";
import { reraStatusLine } from "~/lib/compliance";
import { ctaCopy } from "~/lib/view";
import Picture from "./Picture.astro";
import ReraBadge from "./ReraBadge.astro";
import Disclosure from "./Disclosure.astro";

type Props = { project: Project; settings: SiteSettings; images?: Asset[] };
const { project, settings, images = [] } = Astro.props;
const image = images[0];
const slideshow = images.length > 1;

// Neon motif: vertical light bars (as in BRABUS studio lighting), mostly on the
// right so they frame the image without crossing the headline.
const neon = project.theme.motif === "neon";
const bars = [
  [52, 14, 18, 0],
  [57, 30, 26, 140],
  [61, 8, 22, 300],
  [65, 22, 34, 80],
  [69, 12, 20, 420],
  [73, 34, 24, 220],
  [77, 6, 30, 520],
  [81, 26, 18, 160],
  [85, 14, 36, 360],
  [89, 32, 22, 60],
  [93, 10, 28, 480],
  [97, 24, 20, 260],
].map(([left, top, height, delay]) => ({ left, top, height, delay }));
const cta = ctaCopy(project);
const focus = project.theme.heroFocus ?? "50% 50%";

// "L&T Sector 86, Gurgaon" -> "L&T Sector 86," + italic "Gurgaon" on its own line.
// The H1 text content is unchanged for search engines and screen readers.
const comma = project.name.lastIndexOf(",");
const titleMain = comma > 0 ? project.name.slice(0, comma + 1) : project.name;
const titleAccent = comma > 0 ? project.name.slice(comma + 1).trim() : "";
---

<section class:list={["hero", { "hero--no-image": !image }]} aria-labelledby="hero-title">
  {images.length > 0 && (
    <div class="hero__slides" data-hero-slides data-interval="3000">
      {images.map((img, i) => (
        <div
          class:list={["hero__slide", { "is-active": i === 0 }]}
          aria-hidden={i === 0 ? undefined : "true"}
        >
          <Picture
            slug={project.slug}
            asset={img}
            sizes="100vw"
            eager={i === 0}
            class="hero__img"
            style={`object-position:${img.focus ?? focus}`}
          />
        </div>
      ))}
    </div>
  )}
  <div class="hero__scrim" aria-hidden="true"></div>
  {neon && (
    <div class="hero__neon" aria-hidden="true">
      {bars.map((b) => (
        <span
          class="hero__bar"
          style={`left:${b.left}%;top:${b.top}%;height:${b.height}%;--d:${b.delay}ms`}
        />
      ))}
      <span class="hero__floor" />
    </div>
  )}

  <div class="container hero__inner">
    <div class="hero__content">
      <p class="hero__eyebrow" data-hero-line>
        <span class="hero__rule" aria-hidden="true"></span>
        {project.developer.authorizedToUseName && <span>By {project.developer.name}</span>}
        {project.developer.authorizedToUseName && (
          <span class="hero__dot" aria-hidden="true">
            /
          </span>
        )}
        <span>
          {project.location.sector}, {project.location.city}
        </span>
      </p>
      <h1 id="hero-title" class="hero__title" data-hero-line>
        {titleMain}
        {titleAccent && " "}
        {titleAccent && <em class="hero__accent">{titleAccent}</em>}
      </h1>
      {project.tagline && (
        <p class="hero__tagline" data-hero-line>
          {project.tagline}
        </p>
      )}
      <div class="hero__ctas" data-hero-line>
        <a class="btn hero__primary" href="#contact" data-enquire="hero">
          {cta.primary}
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
        <a class="btn btn--ghost hero__secondary" href="#pricing" data-enquire="pricing">
          {cta.primary === "Register interest" ? "Get pricing first" : "Request pricing"}
        </a>
      </div>
    </div>

    <div class="hero__meta" data-hero-line>
      <ReraBadge project={project} tone="dark" detail={false} />
      <p class="hero__status">{reraStatusLine(project)}</p>
      <Disclosure settings={settings} developer={project.developer} tone="dark" />
    </div>
  </div>

  {(image?.caption || slideshow) && (
    <div class="hero__corner">
      {slideshow && (
        <button
          type="button"
          class="hero__slidectl"
          aria-label="Pause background slideshow"
          aria-pressed="false"
          data-hero-pause
        >
          <svg class="hero__icon-pause" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9 6v12M15 6v12"></path>
          </svg>
          <svg class="hero__icon-play" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9 6.5v11l8.5-5.5z"></path>
          </svg>
        </button>
      )}
      {image?.caption && <p class="hero__caption">{image.caption}</p>}
    </div>
  )}
</section>

<script>
  // Background slideshow: crossfade every 3 s. Pauses when the tab is hidden or
  // the visitor presses pause; never runs under prefers-reduced-motion.
  const root = document.querySelector<HTMLElement>("[data-hero-slides]");
  const slides = root ? Array.from(root.querySelectorAll<HTMLElement>(".hero__slide")) : [];
  const toggle = document.querySelector<HTMLButtonElement>("[data-hero-pause]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (root && slides.length > 1) {
    let index = 0;
    let paused = reduce;
    const show = (next: number) => {
      slides[index]!.classList.remove("is-active");
      slides[index]!.setAttribute("aria-hidden", "true");
      index = next % slides.length;
      slides[index]!.classList.add("is-active");
      slides[index]!.removeAttribute("aria-hidden");
    };
    const setPaused = (value: boolean) => {
      paused = value;
      toggle?.setAttribute("aria-pressed", String(value));
      toggle?.setAttribute(
        "aria-label",
        value ? "Play background slideshow" : "Pause background slideshow",
      );
    };
    setPaused(reduce);
    toggle?.addEventListener("click", () => setPaused(!paused));
    window.setInterval(
      () => {
        if (!paused && !document.hidden) show(index + 1);
      },
      Number(root.dataset.interval) || 3000,
    );
  }
</script>

<style>
  /* Slideshow: slides stack and crossfade; the active one slowly zooms out. */
  .hero__slides {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1200ms var(--ease);
  }
  .hero__slide.is-active {
    opacity: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__slide.is-active :global(.hero__img) {
      animation: hero-kenburns 6s linear both;
    }
  }
  @keyframes hero-kenburns {
    from {
      transform: scale(1.08);
    }
    to {
      transform: scale(1);
    }
  }
  .hero__corner {
    position: absolute;
    right: var(--gutter);
    top: calc(4.25rem + var(--space-3));
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .hero__corner .hero__caption {
    position: static;
  }
  .hero__slidectl {
    flex: none;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 1px solid rgb(244 241 234 / 0.45);
    border-radius: 50%;
    background: rgb(18 17 15 / 0.45);
    color: var(--on-dark);
    cursor: pointer;
  }
  .hero__slidectl:hover {
    background: rgb(18 17 15 / 0.7);
  }
  .hero__slidectl svg {
    width: 14px;
    height: 14px;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
  }
  .hero__icon-play {
    display: none;
    fill: currentColor !important;
  }
  .hero__slidectl[aria-pressed="true"] .hero__icon-pause {
    display: none;
  }
  .hero__slidectl[aria-pressed="true"] .hero__icon-play {
    display: block;
  }
</style>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: clamp(660px, 100svh, 980px);
    padding-top: calc(4.25rem + var(--space-7));
    padding-bottom: var(--space-6);
    overflow: hidden;
    background: var(--night);
    color: var(--on-dark);
  }
  .hero :global(.hero__img),
  .hero :global(picture) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
  }
  .hero :global(.hero__img) {
    object-fit: cover;
    transform-origin: 50% 60%;
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    /* Two layers: a left-side wash behind the text column and a bottom fade for the info strip. */
    background:
      linear-gradient(
        to right,
        rgb(18 17 15 / 0.82) 0%,
        rgb(18 17 15 / 0.62) 32%,
        rgb(18 17 15 / 0.18) 62%,
        rgb(18 17 15 / 0) 80%
      ),
      linear-gradient(
        to top,
        rgb(18 17 15 / 0.94) 0%,
        rgb(18 17 15 / 0.6) 30%,
        rgb(18 17 15 / 0.2) 62%,
        rgb(18 17 15 / 0.5) 100%
      );
  }
  .hero--no-image .hero__scrim {
    display: none;
  }

  .hero__inner {
    display: grid;
    align-content: end;
    gap: clamp(var(--space-6), 5vh, var(--space-8));
  }
  .hero__content {
    display: grid;
    gap: var(--space-5);
    max-width: 48rem;
  }
  .hero__eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--on-dark);
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.55);
  }
  .hero__rule {
    width: 2.5rem;
    height: 1px;
    background: var(--accent);
    filter: brightness(1.4);
  }
  .hero__dot {
    opacity: 0.5;
  }
  .hero__title {
    text-shadow: 0 2px 30px rgb(0 0 0 / 0.45);
    font-size: clamp(3.1rem, 2rem + 5vw, 6.6rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.015em;
  }
  .hero__accent {
    display: block;
    font-style: italic;
    font-weight: 400;
    color: var(--accent-soft);
  }
  .hero__tagline {
    max-width: 34ch;
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--on-dark);
    text-shadow: 0 1px 16px rgb(0 0 0 / 0.55);
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }
  .hero__primary {
    background: var(--on-dark);
    color: var(--on-light);
    border-color: var(--on-dark);
  }
  .hero__primary svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    transition: transform var(--dur) var(--ease);
  }
  .hero__primary:hover {
    background: var(--on-dark-hover);
  }
  .hero__primary:hover svg {
    transform: translateX(3px);
  }
  .hero__secondary {
    color: var(--on-dark);
    border-color: rgb(244 241 234 / 0.55);
    backdrop-filter: blur(2px);
  }
  .hero__secondary:hover {
    background: var(--on-dark);
    color: var(--on-light);
  }
  .hero :focus-visible {
    outline-color: var(--on-dark);
  }

  /* Bottom info strip. */
  .hero__meta {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-5);
    border-top: 1px solid rgb(244 241 234 / 0.2);
  }
  .hero__status {
    font-size: var(--step--1);
    line-height: 1.5;
    color: rgb(244 241 234 / 0.85);
  }
  .hero__meta :global(.disclosure) {
    font-size: 0.8rem;
  }
  @media (min-width: 1024px) {
    .hero__meta {
      grid-template-columns: auto minmax(0, 1fr) minmax(0, 1.25fr);
      align-items: start;
      gap: var(--gutter);
    }
  }

  .hero__caption {
    position: absolute;
    right: var(--gutter);
    top: calc(4.25rem + var(--space-3));
    padding: 0.15rem 0.5rem;
    border-radius: 2px;
    background: rgb(18 17 15 / 0.5);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: rgb(244 241 234 / 0.9);
  }
</style>
