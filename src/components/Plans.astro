---
/**
 * Master plan and floor plans (#plans).
 * With authorized plan assets: blurred previews that open the enquiry modal.
 * Without them: two locked cards over blurred mood imagery. Never a fake plan.
 */
import type { Asset, Project } from "~/lib/schemas";
import type { ProjectBundle } from "~/lib/data";
import SectionHeading from "./SectionHeading.astro";
import Picture from "./Picture.astro";
import LockedCard from "./LockedCard.astro";

type Props = { project: Project; assets: Asset[]; asset: ProjectBundle["asset"] };
const { project, assets, asset } = Astro.props;
const authorized = project.sections.plans && project.developer.authorizedAssets;
const plans = authorized ? assets.filter((a) => a.kind === "plan" && a.usage.includes("plan")) : [];
const dev = project.developer.authorizedToUseName ? project.developer.name : "the developer";
const img = (id?: string) => (id ? asset(id) : undefined);
---

<section class="section" id="plans" aria-labelledby="plans-title">
  <div class="container">
    <SectionHeading
      id="plans-title"
      eyebrow="Plans"
      title="Master plan and floor plans"
      intro={
        plans.length > 0
          ? "Tap a plan to receive the full-resolution version."
          : `Official layouts are released by ${dev} after RERA registration. We never publish unofficial or estimated plans.`
      }
    />
    {plans.length > 0 ? (
      <ul class="plans" role="list">
        {plans.map((a) => (
          <li class="plans__item" data-reveal>
            <a class="plans__preview" href="#contact" data-enquire="floor-plan">
              <Picture
                slug={project.slug}
                asset={a}
                sizes="(min-width: 1024px) 45vw, 100vw"
                class="plans__img"
              />
              <span class="plans__unlock">View full plan</span>
            </a>
            <p class="plans__name">{a.alt}</p>
          </li>
        ))}
      </ul>
    ) : (
      <div class="plans plans--locked">
        <LockedCard
          project={project}
          asset={img(project.sectionImages.masterPlan)}
          id="master-plan"
          eyebrow="Releases at launch"
          title="Master plan"
          text={`Site layout, towers and open spaces, as released by ${dev}.`}
          cta="Get the master plan first"
          intent="floor-plan"
          tall
        />
        <LockedCard
          project={project}
          asset={img(project.sectionImages.floorPlans)}
          id="floor-plans"
          eyebrow="Releases at launch"
          title="Floor plans"
          text="Unit layouts and sizes for every home type, shared the day they are official."
          cta="Get the floor plans first"
          intent="floor-plan"
          tall
        />
      </div>
    )}
  </div>
</section>

<style>
  .plans {
    display: grid;
    gap: var(--space-4);
  }
  .plans__preview {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
  }
  .plans__preview :global(.plans__img) {
    filter: blur(6px);
    transform: scale(1.04);
  }
  .plans__unlock {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius);
    background: var(--ink);
    color: var(--bone);
    font-weight: 600;
  }
  .plans__name {
    margin-top: var(--space-2);
    color: var(--stone);
  }
  @media (min-width: 768px) {
    .plans {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
