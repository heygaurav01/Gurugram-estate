---
/** Hub card: image, name, sector, RERA status chip, link. */
import type { Asset, Project } from "~/lib/schemas";
import { RERA_LABEL } from "~/lib/view";
import Picture from "./Picture.astro";

type Props = { project: Project; image?: Asset | undefined };
const { project, image } = Astro.props;
---

<article class="pcard" data-reveal>
  <div class="pcard__media">
    {image ? (
      <Picture
        slug={project.slug}
        asset={image}
        sizes="(min-width: 1024px) 40vw, 100vw"
        class="pcard__img"
      />
    ) : (
      <div class="pcard__blank" aria-hidden="true" />
    )}
    {image?.caption && <p class="pcard__caption">{image.caption}</p>}
  </div>
  <div class="pcard__body">
    <p class="eyebrow">
      {project.location.sector}, {project.location.city}
    </p>
    <h3 class="pcard__title">
      <a href={`/${project.slug}/`} class="pcard__link">
        {project.name}
      </a>
    </h3>
    <p class="pcard__tagline">{project.tagline}</p>
    <p class="pcard__chip">RERA: {RERA_LABEL[project.rera.status]}</p>
  </div>
</article>

<script>
  // Touch screens have no hover: the first tap highlights a card, a second tap
  // (or a tap on another card) follows the link as usual.
  if (window.matchMedia("(hover: none)").matches) {
    document.querySelectorAll<HTMLElement>(".pcard").forEach((card) => {
      card.addEventListener("click", (e) => {
        if (card.classList.contains("is-active")) return;
        e.preventDefault();
        document
          .querySelectorAll(".pcard.is-active")
          .forEach((c) => c.classList.remove("is-active"));
        card.classList.add("is-active");
      });
    });
  }
</script>

<style>
  /*
   * Layout: in a grid, each card spans five rows (image, place, title, tagline,
   * chip) and uses subgrid, so these parts align across a row whatever the text
   * length. Without subgrid the card falls back to a column with the chip at the
   * bottom. Hover/focus: the card lifts above its neighbours with `scale` (no layout
   * change); under reduced motion only the border and shadow change.
   */
  .pcard {
    --lift: 1.045;
    position: relative;
    z-index: 0;
    display: grid;
    grid-template-rows: auto 1fr;
    background: var(--paper);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 1px 2px rgb(18 17 15 / 0.04);
  }
  /* Doubled class: outranks the scroll-reveal transition and keeps its fade-in. */
  .pcard.pcard {
    transition:
      opacity 500ms var(--ease),
      transform 500ms var(--ease),
      scale 420ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 420ms var(--ease),
      box-shadow 420ms var(--ease);
  }
  @supports (grid-template-rows: subgrid) {
    .pcard {
      grid-row: span 5;
      grid-template-rows: subgrid;
      row-gap: 0;
    }
    .pcard__body {
      grid-row: span 4;
      grid-template-rows: subgrid;
    }
  }
  .pcard:is(:hover, :focus-within, .is-active) {
    z-index: 2;
    border-color: color-mix(in srgb, var(--accent) 70%, transparent);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--accent) 35%, transparent),
      0 34px 60px -30px rgb(18 17 15 / 0.55);
  }
  .pcard__media {
    position: relative;
    overflow: hidden;
  }
  @media (prefers-reduced-motion: no-preference) {
    .pcard:is(:hover, :focus-within, .is-active) {
      scale: var(--lift);
    }
    .pcard__media :global(.pcard__img) {
      transition: scale 900ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .pcard:is(:hover, :focus-within, .is-active) :global(.pcard__img) {
      scale: 1.07;
    }
  }
  .pcard__media :global(.pcard__img),
  .pcard__blank {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--night);
  }
  .pcard__caption {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-2);
    font-size: 0.75rem;
    color: rgb(244 241 234 / 0.85);
  }
  .pcard__body {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-6);
  }
  .pcard__title {
    font-family: var(--font-display);
    font-weight: 500;
    line-height: 1.05;
    font-size: var(--step-2);
    overflow-wrap: anywhere;
    transition: color 420ms var(--ease);
  }
  .pcard:is(:hover, :focus-within, .is-active) .pcard__title {
    color: var(--accent-ink);
  }
  .pcard__link {
    text-decoration: none;
  }
  /* Whole card is clickable via the title link. */
  .pcard__link::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .pcard__link:focus-visible {
    outline: none;
  }
  .pcard:has(.pcard__link:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }
  .pcard__tagline {
    color: var(--ink-2);
  }
  .pcard__chip {
    align-self: end;
    width: fit-content;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    font-size: var(--step--1);
    font-weight: 600;
  }
</style>
