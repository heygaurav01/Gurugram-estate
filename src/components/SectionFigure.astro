---
/** Supporting image for a section, with its caption as a small overlay chip. */
import type { Asset, Project } from "~/lib/schemas";
import Picture from "./Picture.astro";

type Props = {
  project: Project;
  asset: Asset | undefined;
  /** CSS aspect ratio, e.g. "4 / 5". */
  ratio?: string;
  sizes?: string;
  class?: string;
};
const {
  project,
  asset,
  ratio = "4 / 5",
  sizes = "(min-width: 1024px) 40vw, 100vw",
  class: className,
} = Astro.props;
---

{asset && (
  <figure class:list={["sfig", className]} style={`--ratio:${ratio}`} data-reveal>
    <Picture slug={project.slug} asset={asset} sizes={sizes} class="sfig__img" />
    {asset.caption && <figcaption class="sfig__chip">{asset.caption}</figcaption>}
  </figure>
)}

<style>
  .sfig {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--night);
  }
  /* Landscape on small screens so images never push content far down. */
  @media (max-width: 1023.98px) {
    .sfig {
      aspect-ratio: 16 / 10;
    }
  }
  .sfig :global(.sfig__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1200ms var(--ease);
  }
  .sfig:hover :global(.sfig__img) {
    transform: scale(1.03);
  }
  .sfig__chip {
    position: absolute;
    left: var(--space-3);
    bottom: var(--space-3);
    padding: 0.2rem 0.55rem;
    border-radius: 2px;
    background: rgb(18 17 15 / 0.72);
    color: var(--on-dark);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }
</style>
