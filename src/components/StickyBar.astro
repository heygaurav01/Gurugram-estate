---
/**
 * Mobile-only bottom bar with the Enquire action (intent "sticky").
 * Call and WhatsApp live in FloatingContact, floating just above this bar.
 * Hidden at 768px and up.
 */
import type { Project, SiteSettings } from "~/lib/schemas";
import { ctaCopy } from "~/lib/view";

type Props = { settings: SiteSettings; project: Project };
const { project } = Astro.props;
const cta = ctaCopy(project);
---

<nav class="sticky-bar" aria-label="Quick enquiry">
  <a href="#contact" class="sticky-bar__item" data-enquire="sticky">
    Enquire<span class="visually-hidden"> ({cta.primary})</span>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M5 12h14M13 6l6 6-6 6"></path>
    </svg>
  </a>
</nav>

<style>
  .sticky-bar {
    position: fixed;
    inset: auto 0 0;
    z-index: 40;
    display: flex;
    height: calc(var(--sticky-bar-h) + env(safe-area-inset-bottom));
    padding-bottom: env(safe-area-inset-bottom);
    background: var(--ink);
  }
  .sticky-bar__item {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: var(--tap-min);
    color: var(--bone);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.02em;
    text-decoration: none;
  }
  .sticky-bar__item svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
  }
  .sticky-bar__item:focus-visible {
    outline-color: var(--accent);
    outline-offset: -4px;
  }
  @media (min-width: 768px) {
    .sticky-bar {
      display: none;
    }
  }
</style>
