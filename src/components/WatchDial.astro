---
/**
 * Horology motif: a decorative watch dial showing the current time in Gurugram
 * (IST). Guilloche face, applied indices, sweeping seconds hand. Without JS it
 * rests at 10:10, the classic watch display; under reduced motion the hands are
 * set to the time but do not sweep.
 */
const ticks = Array.from({ length: 60 }, (_, i) => i);
const numerals = [
  { n: "12", x: 100, y: 46 },
  { n: "3", x: 156, y: 107 },
  { n: "6", x: 100, y: 166 },
  { n: "9", x: 44, y: 107 },
];
---

<div class="dial" aria-hidden="true" data-watch-dial>
  <svg viewBox="0 0 200 200">
    <defs>
      <radialGradient id="dial-face" cx="50%" cy="40%" r="70%">
        <stop offset="0" stop-color="#fbfaf6"></stop>
        <stop offset="1" stop-color="#e6e2d8"></stop>
      </radialGradient>
      <linearGradient id="dial-bezel" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#f1f3f8"></stop>
        <stop offset="0.5" stop-color="#9aa6bd"></stop>
        <stop offset="1" stop-color="#e3e8f2"></stop>
      </linearGradient>
    </defs>
    <circle cx="100" cy="100" r="98" fill="url(#dial-bezel)"></circle>
    <circle cx="100" cy="100" r="90" fill="url(#dial-face)"></circle>
    <!-- Guilloche: overlapping rings, like an engine-turned dial. -->
    <g class="dial__guilloche" fill="none" stroke="#1f4fa3" stroke-opacity="0.08">
      {Array.from({ length: 12 }, (_, i) => (
        <circle
          cx={100 + 22 * Math.cos((i * Math.PI) / 6)}
          cy={100 + 22 * Math.sin((i * Math.PI) / 6)}
          r="44"
        />
      ))}
    </g>
    <g class="dial__ticks">
      {ticks.map((i) => (
        <line
          x1="100"
          y1={i % 5 === 0 ? 14 : 15}
          x2="100"
          y2={i % 5 === 0 ? 24 : 19}
          stroke="#0f1d3a"
          stroke-width={i % 5 === 0 ? 2.2 : 0.8}
          transform={`rotate(${i * 6} 100 100)`}
        />
      ))}
    </g>
    {numerals.map((d) => (
      <text x={d.x} y={d.y} class="dial__num" text-anchor="middle" dominant-baseline="middle">
        {d.n}
      </text>
    ))}
    <text x="100" y="134" class="dial__label" text-anchor="middle">
      GURUGRAM
    </text>
    <g class="dial__hand dial__hand--h" style="--a:305deg">
      <path d="M100 104 L97 100 L100 56 L103 100 Z" fill="#0f1d3a"></path>
    </g>
    <g class="dial__hand dial__hand--m" style="--a:60deg">
      <path d="M100 106 L98 100 L100 30 L102 100 Z" fill="#0f1d3a"></path>
    </g>
    <g class="dial__hand dial__hand--s" style="--a:0deg">
      <line x1="100" y1="118" x2="100" y2="22" stroke="#1f4fa3" stroke-width="1.2"></line>
      <circle cx="100" cy="100" r="3.6" fill="#1f4fa3"></circle>
    </g>
    <circle cx="100" cy="100" r="1.6" fill="#fbfaf6"></circle>
  </svg>
</div>

<script>
  // Set the hands to the time in Gurugram (IST, UTC+5:30) and keep them current.
  const dial = document.querySelector<HTMLElement>("[data-watch-dial]");
  if (dial) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const set = () => {
      const now = new Date();
      const ist = new Date(now.getTime() + (now.getTimezoneOffset() + 330) * 60_000);
      const s = ist.getSeconds() + ist.getMilliseconds() / 1000;
      const m = ist.getMinutes() + s / 60;
      const h = (ist.getHours() % 12) + m / 60;
      dial.style.setProperty("--h", `${h * 30}deg`);
      dial.style.setProperty("--m", `${m * 6}deg`);
      dial.style.setProperty("--s", `${s * 6}deg`);
      // The seconds hand sweeps with CSS; a negative delay starts it at the right second.
      dial.style.setProperty("--s-delay", `${-s}s`);
    };
    set();
    dial.classList.add("is-live");
    if (!reduce) window.setInterval(set, 30_000);
  }
</script>

<style>
  .dial {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    filter: drop-shadow(0 18px 30px rgb(5 12 30 / 0.55));
  }
  .dial svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .dial__num {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    fill: #0f1d3a;
  }
  .dial__label {
    font-family: var(--font-body);
    font-size: 7px;
    font-weight: 700;
    letter-spacing: 0.24em;
    fill: #1f4fa3;
  }
  .dial__hand {
    transform-origin: 100px 100px;
    transform: rotate(var(--a));
  }
  .dial.is-live .dial__hand--h {
    transform: rotate(var(--h));
  }
  .dial.is-live .dial__hand--m {
    transform: rotate(var(--m));
  }
  .dial.is-live .dial__hand--s {
    transform: rotate(var(--s));
  }
  @media (prefers-reduced-motion: no-preference) {
    .dial.is-live .dial__hand--s {
      animation: dial-sweep 60s linear var(--s-delay, 0s) infinite;
    }
    .dial.is-live .dial__hand--h,
    .dial.is-live .dial__hand--m {
      transition: transform 1s var(--ease);
    }
    .dial__guilloche {
      transform-origin: 100px 100px;
      animation: dial-guilloche 120s linear infinite;
    }
  }
  @keyframes dial-sweep {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes dial-guilloche {
    to {
      transform: rotate(360deg);
    }
  }
</style>
