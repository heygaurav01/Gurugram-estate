---
/**
 * Homepage "The collection": one card per live project page. On wide screens
 * the section pins and the cards slide sideways as the visitor scrolls
 * (scripts/home/home.ts); elsewhere they stack. Each card links to its page.
 */
import type { Asset } from "~/lib/schemas";
import Picture from "../Picture.astro";

export type CollectionItem = {
  slug: string;
  name: string;
  place: string;
  developer?: string | undefined;
  tagline?: string | undefined;
  rera: string;
  image?: Asset | undefined;
};
type Props = { items: CollectionItem[] };
const { items } = Astro.props;
---

<section class="coll" id="projects" data-hscroll aria-labelledby="coll-title">
  <div class="coll__pin">
    <header class="coll__head">
      <p class="eyebrow coll__eyebrow">Floor 01 · The collection</p>
      <h2 id="coll-title" class="coll__title">
        {items.length} project pages, <em>one standard.</em>
      </h2>
      <p class="coll__lead">
        Each page lists only verified facts, with sources and the project's RERA status.
      </p>
      <div class="coll__bar" data-hscroll-bar aria-hidden="true">
        <span></span>
      </div>
    </header>

    <ol class="coll__track" data-hscroll-track role="list">
      {items.map((it, i) => (
        <li class="coll__item" data-card>
          <a class="coll__card" href={`/${it.slug}/`} data-tilt data-ripple>
            <span class="coll__media">
              {it.image ? (
                <Picture
                  slug={it.slug}
                  asset={it.image}
                  sizes="(min-width: 900px) 34vw, 100vw"
                  class="coll__img"
                />
              ) : (
                <span class="coll__blank" />
              )}
              <span class="coll__glare" aria-hidden="true"></span>
              {it.image?.caption && <span class="coll__caption">{it.image.caption}</span>}
            </span>
            <span class="coll__body">
              <span class="coll__num" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              {it.developer && <span class="coll__dev">{it.developer}</span>}
              <span class="coll__name">{it.name}</span>
              <span class="coll__place">{it.place}</span>
              {it.tagline && <span class="coll__tagline">{it.tagline}</span>}
              <span class="coll__foot">
                <span class="coll__chip">RERA: {it.rera}</span>
                <span class="coll__go">
                  Explore project
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6"></path>
                  </svg>
                </span>
              </span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .coll {
    position: relative;
    background: radial-gradient(ellipse at 20% 0%, #2a2216 0%, var(--night) 55%);
    color: var(--on-dark);
  }
  .coll__pin {
    display: grid;
    gap: var(--space-7);
    padding: var(--space-section) var(--gutter);
  }
  .coll__head {
    display: grid;
    gap: var(--space-4);
    max-width: 40rem;
  }
  .coll__eyebrow {
    color: var(--accent-soft);
  }
  .coll__title {
    font-size: var(--step-4);
    line-height: 0.95;
  }
  .coll__title em {
    font-style: italic;
    color: var(--accent-soft);
  }
  .coll__lead {
    font-size: var(--step-1);
    color: rgb(244 241 234 / 0.8);
  }
  .coll__bar {
    display: none;
  }
  .coll__track {
    display: grid;
    gap: var(--space-6);
  }
  .coll__card {
    --rx: 0deg;
    --ry: 0deg;
    position: relative;
    display: grid;
    overflow: hidden;
    border: 1px solid rgb(228 207 168 / 0.22);
    border-radius: 10px;
    background: rgb(244 241 234 / 0.04);
    color: inherit;
    text-decoration: none;
    transform: perspective(1100px) rotateX(var(--rx)) rotateY(var(--ry));
    transition:
      transform 0.5s var(--ease),
      border-color var(--dur) var(--ease);
  }
  .coll__card:hover {
    border-color: rgb(228 207 168 / 0.7);
  }
  .coll__card:focus-visible {
    outline: 2px solid var(--on-dark);
    outline-offset: 4px;
  }
  .coll__media {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: #1a1714;
  }
  .coll__media :global(picture) {
    display: block;
    height: 100%;
  }
  .coll__media :global(.coll__img),
  .coll__blank {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.08) translateX(calc(var(--off, 0) * -6%));
    transition: transform 1.2s var(--ease);
  }
  .coll__card:hover :global(.coll__img) {
    transform: scale(1.14) translateX(calc(var(--off, 0) * -6%));
  }
  .coll__glare {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at var(--gx, 50%) var(--gy, 0%),
      rgb(255 244 220 / 0.28),
      transparent 55%
    );
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
    pointer-events: none;
  }
  .coll__card:hover .coll__glare {
    opacity: 1;
  }
  .coll__caption {
    position: absolute;
    left: var(--space-3);
    top: var(--space-3);
    max-width: calc(100% - 1.5rem);
    padding: 0.1rem 0.45rem;
    border-radius: 2px;
    background: rgb(11 10 9 / 0.55);
    font-size: 0.7rem;
    color: rgb(244 241 234 / 0.85);
  }
  .coll__body {
    position: relative;
    display: grid;
    gap: var(--space-2);
    padding: var(--space-6);
  }
  .coll__num {
    position: absolute;
    top: -2.6rem;
    right: var(--space-5);
    font-family: var(--font-display);
    font-size: 4.6rem;
    font-style: italic;
    line-height: 1;
    color: var(--accent-soft);
    text-shadow: 0 10px 30px rgb(0 0 0 / 0.6);
  }
  .coll__dev {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent-soft);
  }
  .coll__name {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.05;
  }
  .coll__place {
    color: rgb(244 241 234 / 0.7);
  }
  .coll__tagline {
    color: rgb(244 241 234 / 0.85);
  }
  .coll__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
  .coll__chip {
    padding: 0.25rem 0.6rem;
    border: 1px solid rgb(228 207 168 / 0.35);
    border-radius: 999px;
    font-size: var(--step--1);
    font-weight: 600;
  }
  .coll__go {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 600;
    color: var(--accent-soft);
  }
  .coll__go svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    transition: transform var(--dur) var(--ease);
  }
  .coll__card:hover .coll__go svg {
    transform: translateX(4px);
  }

  @media (min-width: 700px) and (max-width: 899.98px) {
    .coll__track {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Pinned horizontal mode (wide screens, motion allowed). */
  .coll:global(.is-pinned) .coll__pin {
    position: sticky;
    top: 0;
    height: 100svh;
    grid-template-rows: auto 1fr;
    /* One screen-wide column: the card row overflows instead of widening it. */
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
    gap: clamp(1.5rem, 4vh, 3rem);
    padding: calc(4.5rem + 2vh) 0 4vh;
    overflow: hidden;
  }
  .coll:global(.is-pinned) .coll__head {
    display: grid;
    grid-template-columns: 1fr minmax(16rem, 32ch);
    align-items: end;
    gap: var(--space-3) var(--space-8);
    max-width: none;
    padding: 0 max(var(--gutter), 6vw);
  }
  .coll:global(.is-pinned) .coll__eyebrow {
    grid-column: 1 / -1;
  }
  .coll:global(.is-pinned) .coll__title {
    font-size: clamp(2.6rem, 1.6rem + 2.6vw, 4.6rem);
  }
  .coll:global(.is-pinned) .coll__lead {
    max-width: 30ch;
    justify-self: end;
    text-align: right;
  }
  .coll:global(.is-pinned) .coll__bar {
    grid-column: 1 / -1;
    display: block;
    width: 100%;
    height: 1px;
    background: rgb(244 241 234 / 0.18);
  }
  .coll:global(.is-pinned) .coll__media {
    aspect-ratio: 16 / 10;
  }
  .coll:global(.is-pinned) .coll__body {
    padding: var(--space-5) var(--space-6);
  }
  .coll:global(.is-pinned) .coll__tagline {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .coll__bar span {
    display: block;
    height: 100%;
    background: var(--accent-soft);
    transform: scaleX(var(--p, 0));
    transform-origin: left;
  }
  .coll:global(.is-pinned) .coll__track {
    display: flex;
    align-items: center;
    gap: 2.5vw;
    width: max-content;
    padding: 0 8vw 0 max(var(--gutter), 6vw);
    will-change: transform;
  }
  .coll:global(.is-pinned) .coll__item {
    width: clamp(19rem, min(28vw, 52vh), 29rem);
    transform: translateY(calc(var(--off, 0) * var(--off, 0) * 6rem))
      rotate(calc(var(--off, 0) * 2deg));
  }
</style>
