---
/**
 * Root layout. Phase 5 replaces the inline meta tags with Seo.astro and JsonLd.astro.
 * Pages render their own Nav and Footer so each can configure them.
 */
import Fonts from "~/components/Fonts.astro";
import "~/styles/tokens.css";
import "~/styles/reset.css";
import "~/styles/base.css";
import "~/styles/layout.css";
import "~/styles/components.css";
import "~/styles/motion.css";

type Props = {
  title: string;
  description: string;
  /** Path such as "/l-and-t-sector-86-gurgaon/". Query strings are never included. */
  path: string;
  noindex?: boolean;
  theme?: { accent: string; accentInk: string } | undefined;
  /** Reserve space for the mobile sticky bar. */
  stickyBar?: boolean;
};

const { title, description, path, noindex = false, theme, stickyBar = false } = Astro.props;
const canonical = new URL(path, Astro.site).href;
const themeStyle = theme
  ? `--project-accent:${theme.accent};--project-accent-ink:${theme.accentInk}`
  : undefined;
---

<!doctype html>
<html lang="en-IN" style={themeStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex,nofollow" : "index,follow"} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Fonts />
    <slot name="head" />
  </head>
  <body class:list={{ "has-sticky-bar": stickyBar }}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <slot />
    <script>
      import { initMotion } from "~/scripts/motion";
      initMotion();
    </script>
  </body>
</html>

<style is:global>
  @media (max-width: 767.98px) {
    body.has-sticky-bar {
      padding-bottom: calc(var(--sticky-bar-h) + env(safe-area-inset-bottom));
    }
  }
</style>
