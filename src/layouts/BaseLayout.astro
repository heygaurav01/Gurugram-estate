---
/**
 * Root layout: SEO head, fonts, global styles and motion.
 * Pages render their own Nav and Footer so each can configure them.
 */
import Fonts from "~/components/Fonts.astro";
import Seo from "~/components/Seo.astro";
import FloatingContact from "~/components/FloatingContact.astro";
import { getSettings } from "~/lib/data";
import { graph, realEstateAgentLd } from "~/lib/seo";
import "~/styles/tokens.css";
import "~/styles/reset.css";
import "~/styles/base.css";
import "~/styles/layout.css";
import "~/styles/components.css";
import "~/styles/motion.css";

type Props = {
  title: string;
  description: string;
  /** Path such as "/l-and-t-sector-86-gurgaon/". Query strings are never included. */
  path: string;
  noindex?: boolean;
  theme?: { accent: string; accentInk: string } | undefined;
  /** Reserve space for the mobile sticky bar. */
  stickyBar?: boolean;
  /** Absolute URL of a 1200x630 share image. */
  ogImage?: string | undefined;
  ogImageAlt?: string | undefined;
  /** Page JSON-LD graph. Defaults to the site-wide RealEstateAgent. */
  jsonLd?: Record<string, unknown> | undefined;
  /** Project named in the floating WhatsApp message, if any. */
  contactProject?: { name: string } | undefined;
};

const {
  title,
  description,
  path,
  noindex = false,
  theme,
  stickyBar = false,
  ogImage,
  ogImageAlt,
  jsonLd,
  contactProject,
} = Astro.props;
const settings = await getSettings();
const ld = jsonLd ?? graph([realEstateAgentLd(settings, Astro.site!)]);
const themeStyle = theme
  ? `--project-accent:${theme.accent};--project-accent-ink:${theme.accentInk}`
  : undefined;
---

<!doctype html>
<html lang="en-IN" style={themeStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      title={title}
      description={description}
      path={path}
      noindex={noindex}
      ogImage={ogImage}
      ogImageAlt={ogImageAlt}
      siteName={settings.business.brand_name}
      jsonLd={ld}
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Fonts />
    <slot name="head" />
  </head>
  <body class:list={{ "has-sticky-bar": stickyBar }}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <slot />
    <FloatingContact settings={settings} project={contactProject} />
    <script>
      import { initMotion } from "~/scripts/motion";
      initMotion();
    </script>
  </body>
</html>

<style is:global>
  @media (max-width: 767.98px) {
    body.has-sticky-bar {
      padding-bottom: calc(var(--sticky-bar-h) + env(safe-area-inset-bottom));
    }
    /* Floating Call/WhatsApp buttons clear the sticky Enquire bar. */
    body.has-sticky-bar .fab {
      bottom: calc(var(--sticky-bar-h) + 14px + env(safe-area-inset-bottom));
    }
  }
</style>
