---
/**
 * The director profile now lives on the homepage (#leadership). This old URL
 * forwards there so shared links keep working; it is noindex and left out of
 * the sitemap.
 */
const target = "/#leadership";
const canonical = new URL(target, Astro.site).href;
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ashish Gutt | Gurugram Estate Pvt Ltd</title>
    <meta name="robots" content="noindex,follow" />
    <link rel="canonical" href={canonical} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
  </head>
  <body>
    <h1>Ashish Gutt</h1>
    <p>
      <a href={target}>Meet Ashish Gutt on our homepage.</a>
    </p>
  </body>
</html>
