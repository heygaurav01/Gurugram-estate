---
/** Thank-you page for the job application form (noindex). */
import BaseLayout from "~/layouts/BaseLayout.astro";
import Nav from "~/components/Nav.astro";
import Footer from "~/components/Footer.astro";
import ThankYou from "~/components/ThankYou.astro";
import { getSettings } from "~/lib/data";
import { companyName } from "~/lib/compliance";

const settings = await getSettings();
const company = companyName(settings);
const copy = {
  lead: `Your application has reached ${company}. There is nothing more you need to do right now.`,
  steps: [
    { title: "We read it", text: "Our team reads your application." },
    { title: "We call you", text: "If it fits the role, we call the number you shared." },
    { title: "We meet", text: "We invite you to talk about the role and next steps." },
  ],
};
---

<BaseLayout
  title={`Thank you | ${company}`}
  description="Your job application has been received."
  path="/careers/thank-you/"
  noindex
>
  <Nav settings={settings} variant="company" />
  <main id="main">
    <ThankYou
      settings={settings}
      from={company}
      back={{ href: "/careers/", label: "Back to careers" }}
      copy={copy}
    />
  </main>
  <Footer settings={settings} variant="company" />
</BaseLayout>
