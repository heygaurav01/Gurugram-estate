---
/** Hub: brand intro and a card for every published project. */
import BaseLayout from "~/layouts/BaseLayout.astro";
import Nav from "~/components/Nav.astro";
import ProjectCard from "~/components/ProjectCard.astro";
import AboutAgent from "~/components/AboutAgent.astro";
import Footer from "~/components/Footer.astro";
import { getProjectBundle, getProjects, getSettings } from "~/lib/data";

const settings = await getSettings();
const projects = await getProjects({ publishedOnly: true });
const cards = await Promise.all(
  projects.map(async (p) => {
    const { asset } = await getProjectBundle(p.slug);
    const imageId = p.theme.heroImageId ?? p.seo.ogImageId;
    return { project: p, image: imageId ? asset(imageId) : undefined };
  }),
);
---

<BaseLayout
  title={`New and upcoming homes in Gurugram | ${settings.business.brand_name}`}
  description="New and upcoming residential projects in Gurugram, tracked by an independent HARERA-registered agent. Verified facts, RERA status and launch updates."
  path="/"
>
  <Nav settings={settings} />
  <main id="main">
    <section class="container hub-intro">
      <p class="eyebrow">Gurugram, Haryana</p>
      <h1>New and upcoming homes in Gurugram, curated by {settings.business.brand_name}</h1>
      <p class="hub-intro__lead">
        We track new residential projects from land acquisition to possession. Every fact on these
        pages links to its source, and pricing appears only after a project is registered with
        HARERA.
      </p>
    </section>

    <section class="container hub-projects" aria-labelledby="projects-title">
      <h2 id="projects-title" class="visually-hidden">
        Projects
      </h2>
      {cards.length > 0 ? (
        <ul class="hub-grid" role="list">
          {cards.map((c) => (
            <li>
              <ProjectCard project={c.project} image={c.image} />
            </li>
          ))}
        </ul>
      ) : (
        <p class="card">New projects will be listed here once we have verified details.</p>
      )}
    </section>

    <AboutAgent settings={settings} />
  </main>
  <Footer settings={settings} />
</BaseLayout>

<style>
  .hub-intro {
    display: grid;
    gap: var(--space-5);
    padding-top: calc(4.25rem + var(--space-section) * 0.6);
    padding-bottom: var(--space-7);
  }
  .hub-intro h1 {
    max-width: 18ch;
  }
  .hub-intro__lead {
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 46ch;
  }
  .hub-projects {
    padding-bottom: var(--space-section);
  }
  .hub-grid {
    display: grid;
    gap: var(--gutter);
  }
  @media (min-width: 1024px) {
    .hub-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
