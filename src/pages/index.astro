---
/**
 * Homepage: the company site of Gurugram Estate Private Limited.
 * Hero, about, the live project pages, how we work, contact.
 * Company content only; every project fact lives on its own page.
 * Motion is CSS plus the shared [data-reveal] fade (scripts/motion.ts).
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import Nav from "~/components/Nav.astro";
import Picture from "~/components/Picture.astro";
import ProjectCard from "~/components/ProjectCard.astro";
import ContactForm from "~/components/ContactForm.astro";
import Footer from "~/components/Footer.astro";
import HiringStrip from "~/components/HiringStrip.astro";
import { getProjectBundle, getProjects, getSettings } from "~/lib/data";
import { COMPANY_NAV_LINKS } from "~/lib/nav";
import { ON_REQUEST, companyName } from "~/lib/compliance";
import { contactView } from "~/lib/view";
import { graph, realEstateAgentLd } from "~/lib/seo";

const settings = await getSettings();
const company = companyName(settings);
const c = contactView(settings);

const projects = await getProjects({ publishedOnly: true });
const cards = await Promise.all(
  projects.map(async (project) => {
    const { asset } = await getProjectBundle(project.slug);
    const id = project.theme.heroImageIds?.[0] ?? project.theme.heroImageId;
    return { project, image: id ? asset(id) : undefined };
  }),
);
const hero = cards.find((card) => card.image);
// "Gurugram Estate Private Limited" -> "Gurugram Estate" + "Private Limited".
const nameParts = company.match(/^(.*?)\s+(Private Limited)$/i);

const principles = [
  {
    title: "Verified facts only.",
    body: "We share what is confirmed, with its source.",
  },
  {
    title: "RERA first.",
    body: "No prices or offers before a project is registered.",
  },
  {
    title: "One advisor, start to finish.",
    body: "Site visits, comparison and paperwork.",
  },
];

const steps = [
  {
    title: "Tell us what you need",
    body: "Budget, sector, home type and timeline. One call is enough to start.",
  },
  {
    title: "Get a sourced shortlist",
    body: "We compare projects using published, dated facts.",
  },
  {
    title: "Visit the sites",
    body: "We arrange visits to the projects you shortlist.",
  },
  {
    title: "Finish the paperwork",
    body: "The same advisor explains the documents and next steps.",
  },
];

const agent = realEstateAgentLd(settings, Astro.site!);
const jsonLd = graph([{ ...agent, legalName: company }]);
---

<BaseLayout
  title={`${company} | Real estate in Gurugram`}
  description={`${company} is a real estate company in Gurugram. Explore live project pages with verified facts, sources and RERA status.`}
  path="/"
  jsonLd={jsonLd}
>
  <meta slot="head" name="facebook-domain-verification" content="zk1k9e0hd6ldp790rewuf3sno161cr" />
  <meta
    slot="head"
    name="ahrefs-site-verification"
    content="d5ec3da8952790d3c01b42ac9b60864f63f6fa907ee03f444659f3426f091b95"
  />
  <Nav settings={settings} overHero variant="company" links={COMPANY_NAV_LINKS} />
  <main id="main">
    <section class="home-hero" aria-labelledby="home-title">
      <HiringStrip settings={settings} />
      {hero?.image && (
        <Picture
          slug={hero.project.slug}
          asset={hero.image}
          sizes="(max-aspect-ratio: 1/1) 180vh, 100vw"
          eager
          class="home-hero__img"
        />
      )}
      <div class="home-hero__veil" aria-hidden="true"></div>
      {hero?.image?.caption && <p class="home-hero__caption">{hero.image.caption}</p>}
      <div class="container home-hero__content">
        <p class="home-hero__eyebrow">Real estate in Gurugram</p>
        <h1 id="home-title" class="home-hero__title">
          {nameParts ? (
            <>
              <span>{nameParts[1]}</span>
              <span class="home-hero__legal">{nameParts[2]}</span>
            </>
          ) : (
            company
          )}
        </h1>
        <p class="home-hero__lead">
          New homes across Gurugram, with verified facts and clear advice.
        </p>
        <div class="home-hero__ctas">
          <a class="btn home-hero__primary" href="#projects">
            View projects
          </a>
          <a class="btn home-hero__secondary" href="#contact">
            Talk to an advisor
          </a>
          {settings.careers.openings.length > 0 && (
            <a class="btn home-hero__secondary" href="/careers/">
              Join our team
            </a>
          )}
        </div>
      </div>
    </section>

    <section class="section home-about" id="about" aria-labelledby="about-title">
      <div class="container home-about__grid">
        <div class="home-about__intro" data-reveal>
          <p class="eyebrow">About us</p>
          <h2 id="about-title">Real estate advice you can verify.</h2>
          <p class="home-about__lead">
            {company} helps buyers in Gurugram compare new projects using facts that can be
            verified.
          </p>
        </div>
        <ol class="home-about__points" role="list" data-reveal>
          {principles.map((p, i) => (
            <li>
              <span class="home-about__num" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span>
                <strong>{p.title}</strong> {p.body}
              </span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section home-projects" id="projects" aria-labelledby="projects-title">
      <div class="container">
        <header class="home-projects__head" data-reveal>
          <p class="eyebrow">Our projects</p>
          <h2 id="projects-title">Explore the live project pages.</h2>
        </header>
        <div class="home-projects__grid">
          {cards.map((card) => (
            <ProjectCard project={card.project} image={card.image} />
          ))}
        </div>
      </div>
    </section>

    <section class="home-approach" id="approach" aria-labelledby="approach-title">
      <div class="container">
        <header class="home-approach__head" data-reveal>
          <p class="eyebrow home-approach__eyebrow">How we work</p>
          <h2 id="approach-title">Four clear steps.</h2>
        </header>
        <ol class="home-approach__steps" role="list">
          {steps.map((s, i) => (
            <li data-reveal>
              <span class="home-approach__num" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section home-contact" id="contact" aria-labelledby="contact-title">
      <div class="container home-contact__grid">
        <div class="home-contact__copy" data-reveal>
          <p class="eyebrow">Contact</p>
          <h2 id="contact-title">Talk to an advisor</h2>
          <p class="home-contact__lead">Tell us what you are looking for. We will call you back.</p>
          <dl class="home-contact__facts">
            <div>
              <dt>HARERA agent registration</dt>
              <dd>{c.reraNo ?? ON_REQUEST}</dd>
            </div>
            {c.phone && (
              <div>
                <dt>Phone and WhatsApp</dt>
                <dd>
                  <a href={c.phone.href}>{c.phone.display}</a>
                </dd>
              </div>
            )}
            {c.email && (
              <div>
                <dt>Email</dt>
                <dd>
                  <a href={`mailto:${c.email}`}>{c.email}</a>
                </dd>
              </div>
            )}
            {c.address && (
              <div>
                <dt>Office</dt>
                <dd>{c.address}</dd>
              </div>
            )}
          </dl>
        </div>
        <div data-reveal>
          <ContactForm settings={settings} />
        </div>
      </div>
    </section>
  </main>
  <Footer settings={settings} variant="company" />
</BaseLayout>

<style>
  /* Hero */
  .home-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-height: max(600px, 100svh);
    overflow: hidden;
    background: var(--night);
    color: var(--on-dark);
  }
  .home-hero :global(.home-hero__img) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .home-hero__veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, rgb(18 17 15 / 0.88), rgb(18 17 15 / 0.2) 60%),
      linear-gradient(to bottom, rgb(18 17 15 / 0.55), transparent 22%);
  }
  .home-hero__caption {
    position: absolute;
    top: calc(4.25rem + var(--tap-min) + var(--space-3));
    right: var(--gutter);
    font-size: 0.72rem;
    color: rgb(244 241 234 / 0.85);
  }
  .home-hero__content {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    padding-block: 10rem var(--space-8);
  }
  /* Phones: keep the buttons clear of the floating call and WhatsApp buttons. */
  @media (max-width: 767.98px) {
    .home-hero__content {
      padding-bottom: 9.5rem;
    }
  }
  .home-hero__eyebrow {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent-soft);
  }
  .home-hero__title {
    display: grid;
    gap: var(--space-3);
    font-size: clamp(3.2rem, 1.6rem + 7vw, 8rem);
    font-weight: 500;
    line-height: 0.95;
  }
  .home-hero__legal {
    font-family: var(--font-body);
    font-size: clamp(0.8rem, 0.72rem + 0.4vw, 1.05rem);
    font-weight: 600;
    letter-spacing: 0.42em;
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--accent-soft);
  }
  .home-hero__lead {
    max-width: 34ch;
    font-size: var(--step-1);
    line-height: 1.4;
  }
  .home-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }
  .home-hero__primary {
    background: var(--accent-soft);
    border-color: var(--accent-soft);
    color: var(--on-light);
  }
  .home-hero__primary:hover {
    background: var(--on-dark);
    border-color: var(--on-dark);
  }
  .home-hero__secondary {
    background: transparent;
    border-color: rgb(244 241 234 / 0.6);
    color: var(--on-dark);
  }
  .home-hero__secondary:hover {
    background: var(--on-dark);
    color: var(--on-light);
  }
  .home-hero :focus-visible {
    outline-color: var(--on-dark);
  }
  @media (prefers-reduced-motion: no-preference) {
    .home-hero :global(.home-hero__img) {
      animation: home-settle 2.4s var(--ease) both;
    }
    .home-hero__content > * {
      animation: home-rise 900ms var(--ease) both;
    }
    .home-hero__content > :nth-child(2) {
      animation-delay: 120ms;
    }
    .home-hero__content > :nth-child(3) {
      animation-delay: 240ms;
    }
    .home-hero__content > :nth-child(4) {
      animation-delay: 360ms;
    }
  }
  @keyframes home-settle {
    from {
      transform: scale(1.06);
    }
  }
  @keyframes home-rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }

  /* About */
  .home-about {
    background: var(--bone);
  }
  .home-about__grid {
    display: grid;
    gap: var(--space-7) var(--gutter);
    align-items: start;
  }
  .home-about__intro {
    display: grid;
    gap: var(--space-4);
  }
  .home-about__intro h2,
  .home-projects__head h2,
  .home-contact__copy h2 {
    font-size: var(--step-3);
  }
  .home-about__lead {
    max-width: 44ch;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-2);
  }
  .home-about__points {
    border-top: 1px solid var(--hairline);
  }
  .home-about__points li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: var(--space-3);
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--hairline);
    color: var(--ink-2);
  }
  .home-about__points strong {
    color: var(--ink);
  }
  .home-about__num {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.1;
    color: var(--accent-ink);
  }

  /* Projects: three cards over two on wide screens. */
  .home-projects {
    background: var(--paper);
  }
  .home-projects__head {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-7);
  }
  .home-projects__grid {
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 700px) {
    .home-projects__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .home-projects__grid {
      grid-template-columns: repeat(6, 1fr);
    }
    .home-projects__grid > :global(*) {
      grid-column: span 2;
    }
    .home-projects__grid > :global(:nth-last-child(-n + 2)) {
      grid-column: span 3;
    }
  }

  /* How we work */
  .home-approach {
    padding-block: var(--space-section);
    background: var(--night);
    color: var(--on-dark);
  }
  .home-approach__head {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-7);
  }
  .home-approach__head h2 {
    font-size: var(--step-3);
  }
  .home-approach__eyebrow {
    color: var(--accent-soft);
  }
  .home-approach__steps {
    display: grid;
    gap: var(--space-6);
  }
  .home-approach__steps li {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid rgb(228 207 168 / 0.4);
    color: rgb(244 241 234 / 0.8);
  }
  .home-approach__steps h3 {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 500;
    line-height: 1.1;
    color: var(--on-dark);
  }
  .home-approach__num {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-style: italic;
    color: var(--accent-soft);
  }
  @media (min-width: 700px) {
    .home-approach__steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Contact */
  .home-contact {
    background: var(--bone);
  }
  .home-contact__grid {
    display: grid;
    gap: var(--space-7) var(--gutter);
    align-items: start;
  }
  .home-contact__copy {
    display: grid;
    gap: var(--space-5);
  }
  .home-contact__lead {
    font-size: var(--step-1);
    line-height: 1.5;
  }
  .home-contact__facts {
    display: grid;
    gap: var(--space-4) var(--gutter);
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    padding-top: var(--space-5);
    border-top: 1px solid var(--hairline);
  }
  .home-contact__facts dt {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--stone);
  }
  .home-contact__facts dd {
    font-size: 1.05rem;
  }

  @media (min-width: 1024px) {
    .home-about__grid,
    .home-contact__grid {
      grid-template-columns: 1fr 1fr;
    }
    .home-approach__steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
